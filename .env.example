# Vercel server-side only (never put secrets in NEXT_PUBLIC_ variables)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=123456789
# Comma-separated public Telegram channel usernames whose owners consented to republishing
ALLOWED_SOURCE_CHANNELS=
# From @BotFather -> Login Widget (OIDC)
TELEGRAM_CLIENT_ID=
TELEGRAM_BOT_USERNAME=shabashkanskbot
# Database for demo/test only; don't put RF citizen personal data on an unverified overseas host
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auto-publish vacancies forwarded by TELEGRAM_ADMIN_IDS. Set false for manual review.
TELEGRAM_AUTO_PUBLISH=true
# Canonical live server URL (not the static private demonstration URL)
SITE_URL=
